---
import Layout from '../../layouts/Layout.astro';
const phone = '+17725550199';
const phoneDisplay = '(772) 555-0199';
---
<Layout title="Visible Mold Growth in Fort Pierce, FL | Fort Pierce Mold Specialists" description="Visible mold on walls, ceilings, or floors in Fort Pierce? Get a professional inspection and safe remediation.">
  <section class="page-hero">
    <div class="container">
      <h1>Visible Mold Growth</h1>
      <p>Visible mold on walls, ceilings, or floors in Fort Pierce? Get a professional inspection and safe remediation.</p>
      <a href={`tel:${phone}`} class="btn btn-primary" style="margin-top:1.25rem">Call {phoneDisplay}</a>
    </div>
  </section>
  <section class="content-section">
    <div class="container" style="max-width:800px">
      <h2>Don’t Ignore What You Can See</h2>
      <p>Spots, patches, or fuzzy growth on drywall, baseboards, ceilings, or wood are clear signs of active mold. Disturbing it without proper protection can spread spores.</p>
      <p>Our team assesses the extent, contains the area, and removes the growth safely so it does not return.</p>
      <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Call Now — {phoneDisplay}</a></p>
    </div>
  </section>
</Layout>
