---
import Layout from '../../layouts/Layout.astro';
const phone = '+17725550199';
const phoneDisplay = '(772) 555-0199';
---
<Layout title="Black Mold Concerns in Fort Pierce, FL | Fort Pierce Mold Specialists" description="Concerned about black mold? Get a professional assessment. Do not disturb suspected growth yourself.">
  <section class="page-hero">
    <div class="container">
      <h1>Black Mold Concerns</h1>
      <p>Concerned about black mold? Get a professional assessment. Do not disturb suspected growth yourself.</p>
      <a href={`tel:${phone}`} class="btn btn-primary" style="margin-top:1.25rem">Call {phoneDisplay}</a>
    </div>
  </section>
  <section class="content-section">
    <div class="container" style="max-width:800px">
      <h2>Treat Dark Growth Seriously</h2>
      <p>Not all dark mold is Stachybotrys, but any significant growth that looks black or green-black should be evaluated by professionals. Disturbing it can release more spores.</p>
      <p>We inspect safely, determine the appropriate response, and perform remediation with proper containment when needed.</p>
      <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Call Now — {phoneDisplay}</a></p>
    </div>
  </section>
</Layout>
