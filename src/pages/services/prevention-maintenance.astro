---
import Layout from '../../layouts/Layout.astro';
const phone = '+17725550199';
const phoneDisplay = '(772) 555-0199';
---
<Layout title="Mold Prevention & Maintenance in Fort Pierce, FL" description="Mold prevention and humidity control guidance for Fort Pierce homes. Keep mold from coming back.">
  <section class="page-hero">
    <div class="container">
      <h1>Prevention & Maintenance</h1>
      <p>Mold prevention and humidity control guidance for Fort Pierce homes. Keep mold from coming back.</p>
      <a href={`tel:${phone}`} class="btn btn-primary" style="margin-top:1.25rem">Call </a>
    </div>
  </section>
  <section class="content-section">
    <div class="container" style="max-width:800px">
<h2>Stop Mold Before It Starts</h2>
<p>Florida’s climate makes prevention critical. After remediation — or to avoid problems — we help you control humidity and fix moisture sources.</p>
<ul>
<li>Target indoor humidity below 60%</li>
<li>Fix leaks and drainage issues promptly</li>
<li>Improve ventilation in bathrooms and kitchens</li>
<li>Maintain HVAC and change filters regularly</li>
</ul>
<p>Ask us for practical recommendations tailored to your home or business in the Fort Pierce area.</p>
      <p style="margin-top:2rem"><a href={`tel:${phone}`} class="btn btn-primary">Call Now — </a></p>
    </div>
  </section>
</Layout>
